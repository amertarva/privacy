<script>
  const toggleDraftBtns = [
    document.getElementById('toggle-draft-mode-btn'),
    document.getElementById('mobile-toggle-draft-btn')
  ];
  const draftLabel = document.getElementById('draft-mode-label');
  const openChecklistPanelBtn = document.getElementById('open-checklist-panel-btn');
  const checklistModal = document.getElementById('checklist-modal');

  let isHighlighted = true;

  function setPlaceholderHighlight(highlight: boolean) {
    const badges = document.querySelectorAll('.placeholder-badge');
    badges.forEach((el) => {
      if (highlight) {
        el.classList.add('ring-2', 'ring-amber-400/80', 'animate-pulse');
      } else {
        el.classList.remove('ring-2', 'ring-amber-400/80', 'animate-pulse');
      }
    });

    if (draftLabel) {
      draftLabel.textContent = highlight ? 'Sorot Placeholder [Aktif]' : 'Sorot Placeholder [Draf]';
    }
  }

  toggleDraftBtns.forEach(btn => {
    btn?.addEventListener('click', () => {
      isHighlighted = !isHighlighted;
      setPlaceholderHighlight(isHighlighted);
    });
  });

  openChecklistPanelBtn?.addEventListener('click', () => {
    checklistModal?.classList.remove('hidden');
  });

  setPlaceholderHighlight(true);
</script>
