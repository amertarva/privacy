---
import { 
  ShieldCheck, 
  Search, 
  Printer, 
  CheckSquare, 
  Sparkles, 
  FileText,
  Menu,
  X
} from '@lucide/astro';
---

<header class="sticky top-0 z-40 w-full border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md no-print">
  <!-- Reading progress indicator -->
  <div 
    id="reading-progress" 
    class="h-0.5 w-0 bg-gradient-to-r from-indigo-500 via-cyan-400 to-emerald-400 transition-[width] duration-150 ease-out"
    style="width: 0%"
  ></div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand identity -->
    <a href="#" class="group flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-700 shadow-lg shadow-indigo-500/20 ring-1 ring-white/20 transition-transform group-hover:scale-105">
        <ShieldCheck class="h-5 w-5 text-white" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-base font-bold tracking-tight text-white">Amertarva LMS</span>
          <span class="rounded-full border border-indigo-500/30 bg-indigo-500/10 px-2 py-0.5 text-[10px] font-semibold text-indigo-300">
            UU PDP Ready
          </span>
        </div>
        <p class="text-xs text-slate-400">Kebijakan Privasi & Tata Kelola Data</p>
      </div>
    </a>

    <!-- Action bar -->
    <div class="hidden items-center gap-2 md:flex">
      <!-- Search trigger button -->
      <button 
        id="open-search-btn"
        type="button" 
        class="flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/80 px-3 py-1.5 text-xs text-slate-400 transition hover:border-slate-700 hover:bg-slate-900 hover:text-slate-200"
        title="Cari dalam dokumen (Ctrl+K)"
      >
        <Search class="h-3.5 w-3.5 text-indigo-400" />
        <span>Cari topik atau istilah...</span>
        <kbd class="ml-2 rounded border border-slate-700 bg-slate-800 px-1.5 py-0.5 text-[10px] font-mono text-slate-400">Ctrl K</kbd>
      </button>

      <!-- Review Mode Toggle -->
      <button 
        id="toggle-draft-mode-btn"
        type="button" 
        class="flex items-center gap-1.5 rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-1.5 text-xs font-medium text-amber-300 transition hover:bg-amber-500/20"
        title="Tampilkan / sembunyikan penanda kolom isian draf"
      >
        <Sparkles class="h-3.5 w-3.5 text-amber-400" />
        <span id="draft-mode-label">Sorot Placeholder [Draf]</span>
      </button>

      <!-- Checklist Drawer Trigger -->
      <button 
        id="open-checklist-btn"
        type="button" 
        class="flex items-center gap-1.5 rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-3 py-1.5 text-xs font-medium text-indigo-300 transition hover:bg-indigo-500/20"
        title="Daftar pemeriksaan internal untuk pemilik/pengembang LMS"
      >
        <CheckSquare class="h-3.5 w-3.5 text-indigo-400" />
        <span>Daftar Periksa Kepatuhan</span>
        <span id="checklist-counter-badge" class="ml-1 rounded-full bg-indigo-600 px-1.5 py-0.2 text-[10px] text-white">0/11</span>
      </button>

      <!-- Print document -->
      <button 
        id="print-btn"
        type="button" 
        class="flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900 px-3 py-1.5 text-xs font-medium text-slate-300 transition hover:border-slate-700 hover:text-white"
        title="Cetak atau simpan sebagai PDF"
      >
        <Printer class="h-3.5 w-3.5 text-slate-400" />
        <span>Cetak PDF</span>
      </button>
    </div>

    <!-- Mobile menu toggle -->
    <div class="flex items-center gap-2 md:hidden">
      <button 
        id="mobile-search-btn"
        type="button" 
        class="rounded-lg border border-slate-800 bg-slate-900 p-2 text-slate-300"
        aria-label="Cari dokumen"
      >
        <Search class="h-4 w-4" />
      </button>

      <button 
        id="mobile-menu-btn"
        type="button" 
        class="rounded-lg border border-slate-800 bg-slate-900 p-2 text-slate-300"
        aria-label="Buka menu navigasi"
      >
        <Menu class="h-5 w-5" id="mobile-menu-icon-open" />
        <X class="hidden h-5 w-5" id="mobile-menu-icon-close" />
      </button>
    </div>
  </div>

  <!-- Mobile dropdown drawer -->
  <div id="mobile-dropdown" class="hidden border-t border-slate-800/80 bg-slate-950 px-4 py-4 md:hidden">
    <div class="flex flex-col gap-2.5">
      <button 
        id="mobile-toggle-draft-btn"
        type="button" 
        class="flex w-full items-center justify-between rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-xs font-medium text-amber-300"
      >
        <span class="flex items-center gap-2">
          <Sparkles class="h-4 w-4 text-amber-400" />
          <span>Sorot Placeholder [Draf]</span>
        </span>
        <span class="text-[10px] bg-amber-500/20 px-2 py-0.5 rounded">Toggle</span>
      </button>

      <button 
        id="mobile-open-checklist-btn"
        type="button" 
        class="flex w-full items-center justify-between rounded-lg border border-indigo-500/30 bg-indigo-500/10 px-3 py-2 text-xs font-medium text-indigo-300"
      >
        <span class="flex items-center gap-2">
          <CheckSquare class="h-4 w-4 text-indigo-400" />
          <span>Daftar Periksa Kepatuhan</span>
        </span>
        <span id="mobile-checklist-badge" class="rounded-full bg-indigo-600 px-2 py-0.5 text-[10px] text-white">0/11</span>
      </button>

      <button 
        id="mobile-print-btn"
        type="button" 
        class="flex w-full items-center gap-2 rounded-lg border border-slate-800 bg-slate-900 px-3 py-2 text-xs font-medium text-slate-300"
      >
        <Printer class="h-4 w-4 text-slate-400" />
        <span>Cetak Dokumen / Simpan PDF</span>
      </button>
    </div>
  </div>
</header>

<script>
  const progressBar = document.getElementById('reading-progress');
  window.addEventListener('scroll', () => {
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight > 0 && progressBar) {
      const percentage = (window.scrollY / totalHeight) * 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, percentage))}%`;
    }
  });

  const printBtn = document.getElementById('print-btn');
  const mobilePrintBtn = document.getElementById('mobile-print-btn');
  const handlePrint = () => window.print();
  printBtn?.addEventListener('click', handlePrint);
  mobilePrintBtn?.addEventListener('click', handlePrint);

  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDropdown = document.getElementById('mobile-dropdown');
  const iconOpen = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  mobileMenuBtn?.addEventListener('click', () => {
    const isHidden = mobileDropdown?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', isHidden);
  });
</script>
