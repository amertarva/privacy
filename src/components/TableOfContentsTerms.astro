---
import { 
  FileCheck2, 
  BookOpen, 
  Baby, 
  UserCheck, 
  KeyRound, 
  FileText, 
  Ban, 
  GraduationCap, 
  Server, 
  AlertTriangle, 
  UserX, 
  Building2, 
  Scale, 
  Mail,
  ShieldCheck
} from '@lucide/astro';

const sections = [
  { id: 'penerimaan', number: '1', title: 'Penerimaan & Ruang Lingkup', icon: FileCheck2 },
  { id: 'definisi', number: '2', title: 'Definisi Operasional', icon: BookOpen },
  { id: 'pengguna-anak', number: '3', title: 'Kelayakan & Pengguna Anak', icon: Baby },
  { id: 'akun-keamanan', number: '4', title: 'Akun & Kredensial Akses', icon: UserCheck },
  { id: 'lisensi', number: '5', title: 'Lisensi & Hak Cipta Platform', icon: KeyRound },
  { id: 'konten-pengguna', number: '6', title: 'Materi Belajar & Hak Cipta', icon: FileText },
  { id: 'larangan', number: '7', title: 'Pedoman Perilaku & Larangan', icon: Ban },
  { id: 'ujian-cbt', number: '8', title: 'Integritas Ujian & Asesmen', icon: GraduationCap },
  { id: 'ketersediaan-sla', number: '9', title: 'Ketersediaan & Pemeliharaan', icon: Server },
  { id: 'batasan-tanggung-jawab', number: '10', title: 'Batasan Tanggung Jawab', icon: AlertTriangle },
  { id: 'penangguhan-terminasi', number: '11', title: 'Penangguhan & Terminasi', icon: UserX },
  { id: 'kerjasama-b2b', number: '12', title: 'Kemitraan Sekolah (B2B)', icon: Building2 },
  { id: 'hukum-sengketa', number: '13', title: 'Hukum & Sengketa', icon: Scale },
  { id: 'kontak-amandemen', number: '14', title: 'Pembaruan & Kontak Resmi', icon: Mail },
];
---

<nav class="sticky top-20 rounded-2xl border border-slate-800 bg-slate-900/60 p-4 backdrop-blur-md no-print" aria-label="Daftar Isi Syarat dan Ketentuan">
  <div class="flex items-center justify-between pb-3 border-b border-slate-800">
    <div class="flex items-center gap-2">
      <Scale class="h-4 w-4 text-cyan-400" />
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300">Daftar Isi Ketentuan</h3>
    </div>
    <span class="rounded bg-cyan-500/10 px-2 py-0.5 text-[10px] font-medium text-cyan-300">14 Pasal</span>
  </div>

  <div class="mt-3 max-h-[calc(100vh-140px)] overflow-y-auto pr-1 space-y-1 text-xs">
    {sections.map((item) => (
      <a 
        href={`#${item.id}`}
        class="toc-link group flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-slate-400 transition hover:bg-slate-800/80 hover:text-white"
        data-target={item.id}
      >
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-slate-800 text-[10px] font-mono font-medium text-slate-300 group-hover:bg-cyan-600 group-hover:text-white transition">
          {item.number}
        </span>
        <span class="truncate">{item.title}</span>
      </a>
    ))}

    <div class="pt-3 mt-2 border-t border-slate-800/80 space-y-1">
      <a 
        href="/"
        class="flex items-center gap-2 rounded-lg bg-indigo-500/10 px-2.5 py-2 text-indigo-300 transition hover:bg-indigo-500/20 font-medium"
      >
        <ShieldCheck class="h-4 w-4 text-indigo-400 shrink-0" />
        <span class="truncate">Baca Kebijakan Privasi</span>
      </a>
    </div>
  </div>
</nav>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          document.querySelectorAll('.toc-link').forEach((link) => {
            if (link.getAttribute('data-target') === id) {
              link.classList.add('bg-slate-800', 'text-white', 'font-medium');
              link.querySelector('span')?.classList.add('bg-cyan-600', 'text-white');
            } else {
              link.classList.remove('bg-slate-800', 'text-white', 'font-medium');
              link.querySelector('span')?.classList.remove('bg-cyan-600', 'text-white');
            }
          });
        }
      });
    },
    {
      rootMargin: '-80px 0px -70% 0px',
      threshold: 0
    }
  );

  document.querySelectorAll('article[id]').forEach((section) => {
    observer.observe(section);
  });
</script>
