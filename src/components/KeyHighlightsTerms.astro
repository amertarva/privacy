---
import { 
  KeyRound, 
  GraduationCap, 
  Copyright, 
  ShieldCheck, 
  Sparkles,
  HelpCircle,
  FileText,
  AlertTriangle
} from '@lucide/astro';

const highlights = [
  {
    icon: KeyRound,
    color: 'from-blue-500 to-indigo-600',
    title: 'Lisensi & Hak Akses',
    subtitle: 'Akses Edukatif Terbatas',
    description: 'Amertarva memberikan lisensi terbatas, non-eksklusif, dan dapat dibatalkan untuk mengakses fitur LMS bagi siswa, guru, dan admin sekolah yang terdaftar resmi.',
    link: '#lisensi'
  },
  {
    icon: GraduationCap,
    color: 'from-emerald-500 to-teal-600',
    title: 'Integritas Akademik & Ujian',
    subtitle: 'Nol Toleransi Kecurangan',
    description: 'Dilarang keras menyebarkan lembar soal CBT, menggunakan alat bantu joki/otomatisasi, atau memanipulasi catatan waktu pengerjaan tugas dan evaluasi belajar.',
    link: '#ujian-cbt'
  },
  {
    icon: Copyright,
    color: 'from-purple-500 to-violet-600',
    title: 'Hak Cipta & Konten',
    subtitle: 'Kepemilikan Materi Guru & Siswa',
    description: 'Materi modul pembelajaran tetap milik guru/sekolah. Karya tugas siswa tetap milik siswa. Amertarva hanya memegang hak cipta atas platform dan kode sistem.',
    link: '#konten-pengguna'
  },
  {
    icon: ShieldCheck,
    color: 'from-amber-500 to-orange-600',
    title: 'Perlindungan Pengguna Anak',
    subtitle: 'Persetujuan Institusi & Wali',
    description: 'Siswa di bawah 18 tahun didaftarkan melalui sekolah dengan persetujuan orang tua/wali sesuai amanat UU Perlindungan Anak dan UU Pelindungan Data Pribadi.',
    link: '#pengguna-anak'
  }
];
---

<div class="rounded-2xl border border-indigo-500/20 bg-gradient-to-b from-indigo-950/30 to-slate-900/40 p-6 backdrop-blur-sm print-card">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-5 border-b border-slate-800">
    <div class="flex items-center gap-2.5">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-500/20 text-indigo-400">
        <Sparkles class="h-4 w-4" />
      </div>
      <div>
        <h3 class="text-sm font-bold tracking-tight text-white">Intisari Ketentuan Layanan (TL;DR)</h3>
        <p class="text-xs text-slate-400">Ringkasan cepat poin hukum utama sebelum Anda menyetujui dan menggunakan layanan</p>
      </div>
    </div>
    <span class="inline-flex items-center gap-1.5 self-start sm:self-auto rounded-full border border-indigo-500/30 bg-indigo-500/10 px-2.5 py-1 text-[11px] font-medium text-indigo-300">
      <HelpCircle class="h-3 w-3" />
      <span>Ringkasan Eksekutif</span>
    </span>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {highlights.map((item) => {
      const Icon = item.icon;
      return (
        <a 
          href={item.link} 
          class="group relative flex flex-col justify-between rounded-xl border border-slate-800/80 bg-slate-900/60 p-4 transition-all duration-200 hover:border-slate-700 hover:bg-slate-800/50 hover:shadow-lg"
        >
          <div>
            <div class={`inline-flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br ${item.color} text-white shadow-md shadow-indigo-500/10 group-hover:scale-105 transition-transform`}>
              <Icon class="h-4 w-4" />
            </div>
            <h4 class="mt-3 text-xs font-bold text-white group-hover:text-indigo-300 transition-colors">
              {item.title}
            </h4>
            <span class="text-[10px] font-medium text-indigo-400">
              {item.subtitle}
            </span>
            <p class="mt-2 text-xs text-slate-400 leading-relaxed">
              {item.description}
            </p>
          </div>
          <span class="mt-4 flex items-center gap-1 text-[11px] font-medium text-indigo-400 group-hover:text-indigo-300">
            <span>Baca rincian pasal</span>
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      );
    })}
  </div>
</div>
